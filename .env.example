# Yomizaka — local development. Copy to .env (never committed). Every variable is declared in apps/web/lib/env.ts.
APP_PUBLIC_URL=http://localhost:3000
# Optional credentials for the dev/local demo persona seed.
APP_DEMO_ACCOUNT_EMAIL=
APP_DEMO_ACCOUNT_PASSWORD=
# A local PostgreSQL 16 (docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/yomizaka_db
# DATABASE_CA_CERT=            # the cluster's CA (PEM) — dev/production only
AUTH_SESSION_SECRET=           # ≥ 32 characters in production; a development default otherwise
AUTH_SIGNUP_ENABLED=false
AUTH_ALLOWED_IPS=              # the administration's addresses; empty in development = anybody
ABUSE_CLIENT_IP_HEADER=        # do-connecting-ip on App Platform
AI_PROVIDER=orazaka
AI_API_URL=https://dev.orazaka.com/edge
AI_API_KEY=                    # oz_… (Orazaka dev-deploy.mjs service-account yomizaka)
APP_REPORT_SIGNING_KEY=        # Ed25519 key of the audit reports (node scripts/generate-report-key.mjs <env-file>); a public development key otherwise
