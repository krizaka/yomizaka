{
  "name": "yomizaka-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Yomizaka — your documents, read and checked by Orazaka: upload, keep, search, and every analysis traced to an Orazaka run.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@yomizaka/web",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run check:i18n",
    "check:i18n": "krizaka-i18n check apps/web/messages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "seo:check": "node scripts/check-seo-family.mjs --base http://localhost:3000 --host https://dev.yomizaka.com --types WebSite,SoftwareApplication"
  },
  "devDependencies": {
    "@krizaka/i18n": "^0.2.1",
    "turbo": "^2.11.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "Krizaka"
}
