{
  "name": "yomizaka-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Yomizaka — your documents, read and checked by Orazaka: upload, keep, search, and every analysis traced to an Orazaka run.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@yomizaka/web",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run check:i18n && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs",
    "check:i18n": "krizaka-i18n check apps/web/messages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "seo:check": "node scripts/check-seo-family.mjs --base http://localhost:3000 --host https://www.yomizaka.com --types WebSite,SoftwareApplication",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:admin-live": "node scripts/check-admin-live.mjs",
    "payments:setup": "pnpm --filter @yomizaka/web exec krizaka-payments-setup --catalogue ../../deploy/payments-catalogue.json"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/i18n": "^0.2.1",
    "playwright-core": "1.64.0",
    "turbo": "^2.11.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "Krizaka"
}
