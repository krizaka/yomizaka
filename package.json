{
  "name": "yomizaka-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Yomizaka — your documents, read and checked by Orazaka: upload, keep, search, and every analysis traced to an Orazaka run.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@yomizaka/web",
    "build": "turbo run build",
    "lint:workspace": "npx --yes -p @krizaka/config@latest krizaka-workspace-guard",
    "lint": "pnpm run lint:workspace && turbo run lint && pnpm run check:i18n && ast-grep test --skip-snapshot-tests && krizaka-sg-ratchet",
    "check:i18n": "krizaka-i18n check apps/web/messages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "test:coverage": "turbo run test --filter='!./apps/mobile' -- --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov && turbo run test --filter='./apps/mobile' && vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "seo:check": "krizaka-seo-family --base http://localhost:3000 --host https://www.yomizaka.com --types WebSite,SoftwareApplication",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "lint:sg": "krizaka-sg-ratchet",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "krizaka-sg-ratchet --update",
    "sg:fix": "node scripts/sg-fix.mjs",
    "demo:documents": "node scripts/demo-documents/cli.mjs",
    "demo:seed": "node scripts/demo-seed/cli.mjs",
    "dev:seed": "node scripts/demo-seed/cli.mjs --cast",
    "dev:launch-offer": "node scripts/launch-offer.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:admin-live": "node scripts/check-admin-live.mjs",
    "payments:setup": "pnpm --filter @yomizaka/web exec krizaka-payments-setup --catalogue ../../deploy/payments-catalogue.json",
    "check:app-links": "pnpm --filter @yomizaka/web exec vitest run lib/app-links.test.ts",
    "test:visual": "playwright test -c apps/web/e2e/visual/playwright.config.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/a11y-audit": "0.2.0",
    "@krizaka/config": "^0.13.0",
    "@krizaka/i18n": "^0.2.1",
    "@krizaka/intl": "^0.3.0",
    "@krizaka/org": "^0.3.1",
    "@krizaka/page-audit": "^0.6.0",
    "@playwright/test": "1.64.0",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "^18.7.0",
    "playwright-core": "1.64.0",
    "turbo": "^2.11.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "FSL-1.1-ALv2",
  "author": "Krizaka"
}
