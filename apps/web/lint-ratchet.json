{
  "globs": [
    "app/**/*.tsx",
    "components/**/*.tsx",
    "src/**/*.tsx"
  ],
  "stackGlobs": [
    "app/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "components/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "src/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "lib/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "hooks/**/*.{js,jsx,mjs,ts,tsx,mts}",
    "features/**/*.{js,jsx,mjs,ts,tsx,mts}"
  ],
  "counters": {
    "palette": 0,
    "light": 0,
    "arbitraryVar": 0,
    "classNameTemplate": 0,
    "fetchInClientEffect": 0,
    "asyncInEffect": 0,
    "derivedStateInEffect": 0,
    "directTanstackImport": 0,
    "localTableOrForm": 0,
    "retiredImport": 0,
    "routeStateSelection": 0,
    "cognitiveComplexity": 0,
    "sonar": 19,
    "sonarjs/no-nested-template-literals": 5,
    "sonarjs/no-nested-conditional": 7,
    "sonarjs/sql-queries": 2,
    "sonarjs/duplicates-in-character-class": 1,
    "sonarjs/anchor-precedence": 1,
    "sonarjs/regex-complexity": 2,
    "sonarjs/super-linear-regex": 1,
    "pageTemplate": 47
  }
}
