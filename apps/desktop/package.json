{
  "name": "@yomizaka/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Yomizaka for the Mac (Tauri 2): a library in a folder of your Mac, documents checked and never kept elsewhere.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm typecheck && pnpm test && pnpm test:rust",
    "tauri": "tauri",
    "build:app": "tauri build --bundles dmg --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@krizaka/app-client": "^0.2.0",
    "@krizaka/app-desktop": "^0.1.0",
    "@krizaka/i18n": "^0.2.1",
    "@krizaka/icons": "^0.7.0",
    "@krizaka/query": "^0.2.2",
    "@krizaka/tailwind": "^3.63.0",
    "@krizaka/tokens": "^3.63.0",
    "@krizaka/ui": "^3.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@yomizaka/client": "workspace:*",
    "@yomizaka/core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
